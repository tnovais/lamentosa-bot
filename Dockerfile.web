FROM node:20-bullseye

WORKDIR /app

# Copy package files
COPY web/package*.json ./

# Remove Windows lockfile to ensure Linux binaries are downloaded
RUN rm -f package-lock.json

# Install dependencies
RUN npm install

# Copy source code
COPY web/ .

# Generate Prisma Client
ENV DATABASE_URL="mysql://dummy:dummy@localhost:3306/dummy"
RUN npx prisma generate

# Build Next.js
RUN npm run build

# Expose port
EXPOSE 3000

# Start Next.js
CMD ["npm", "start"]
