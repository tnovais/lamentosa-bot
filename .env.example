# ------------------------------------------------------------------------------
# INFRASTRUCTURE (Docker / DB / Redis)
# ------------------------------------------------------------------------------
DB_USER=lamentosa
DB_PASSWORD=secure_password
DB_NAME=lamentosa_bot
DB_PORT=3306
DATABASE_URL="mysql://lamentosa:secure_password@localhost:3306/lamentosa_bot"

REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

WEB_PORT=3000

# ------------------------------------------------------------------------------
# BOT CONFIGURATION
# ------------------------------------------------------------------------------
# Accounts are now managed via the Web Dashboard (MySQL)
# No hardcoded accounts needed here.

# 2Captcha Configuration
CAPTCHA_API_KEY=your_2captcha_api_key_here

# Global Limits
MAX_DAILY_FARMS=100
MAX_DAILY_PVE=18
MAX_DAILY_PLAYTIME_MINUTES=480
ATTACKS_PER_CYCLE=3
COOLDOWN_MINUTES=20

# Game URLs
GAME_BASE_URL=https://se.lamentosa.com
GAME_STATUS_URL=https://se.lamentosa.com/status/

# Delays (Milliseconds)
DELAY_NAV_MIN=1000
DELAY_NAV_MAX=3000
DELAY_NAV_RETRY_MIN=1000
DELAY_NAV_RETRY_MAX=2000
DELAY_CLICK_MIN=500
DELAY_CLICK_MAX=1500
DELAY_COMBAT_MIN=2000
DELAY_COMBAT_MAX=4000
DELAY_NETWORK_IDLE=5000

# Decision Weights (Fuzzy Logic)
# Attack
WEIGHT_ATTACK_HP_THRESHOLD=50
WEIGHT_ATTACK_LOW=20

# Heal
WEIGHT_HEAL_CURVE_MAX=100
WEIGHT_HEAL_POTION_BOOST=20
WEIGHT_HEAL_CRITICAL_HP=40

# Flee
WEIGHT_FLEE_HP_CRITICAL=20
WEIGHT_FLEE_SCORE=90

# Farm
WEIGHT_FARM_BOREDOM_THRESHOLD=5
WEIGHT_FARM_BOREDOM_SCORE=30
WEIGHT_FARM_NORMAL_SCORE=60
LIMIT_DAILY_FARMS=1000

# Ranking
RANKING_CHECK_INTERVAL_MINUTES=15

# Logging
LOG_LEVEL=info
DEBUG_MODE=true
